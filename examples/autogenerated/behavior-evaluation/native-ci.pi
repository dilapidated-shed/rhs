"""FP/Kitchen native findings with independent AI-CI admission."""
import os
import sys
import subprocess
from pathlib import Path
from builtins import ValueError, globals

def run(argv ∈ list[str], root ∈ str) → None:
    result ∈ object ← subprocess.run(argv, cwd=root)
    code ∈ int ← result.returncode
    if code != 0:
        raise ValueError("Required native finding stage failed")

def main() → None:
    arguments ∈ list[str] ← sys.argv
    root ∈ str ← Path(arguments[1]).read_text().strip()
    if root != "/home/runner/work/rhs/rhs":
        raise ValueError("Native finding executor requires the verified GitHub workspace")
    work ∈ str ← root + "/.native-work"
    pins ∈ dict[str, str] ← {"ithon": "d6e83969f82512e920fb17b44326cb54f31d015c", "catfood": "90471095201bcabeb7ef920fa0101f4e667d1454", "ai-ci": "a82d40bab9dc040e17bd420c11d9346f103262ad", "kitchen": "3613efd6c8550f4f7c70c27ee06c6e8ef8bb1051", "flexible-pipes": "133e0b5a4e04a928e1c8999a22bd153339e49856"}
    for owner in pins:
        result ∈ object ← subprocess.run(["git", "rev-parse", "HEAD"], cwd=work + "/" + owner, capture_output=True, text=True, check=True)
        revision ∈ str ← result.stdout.strip()
        if revision != pins[owner]:
            raise ValueError("Native finding owner source mismatch: " + owner)
    ithon ∈ str ← work + "/ithon/ithon"
    run([ithon, work + "/catfood/profiles/rhs-evaluation/provision.pi", "grease", work], root)
    environment ∈ dict[str, str] ← os.environ
    old_path ∈ str ← environment.get("PATH", "")
    environment["PATH"] ← work + "/profile/bin:" + old_path
    run(["python3", work + "/flexible-pipes/scripts/run-pipeline", "rhs-native-findings", "--param", "kitchen_task=" + work + "/kitchen/tasks/rhs-autonomous/relations.grease", "--param", "rhs=" + root, "--param", "evidence=" + work + "/evidence", "--param", "ithon=" + ithon, "--param", "checker=" + work + "/ai-ci/validators/accept_rhs_native.pi", "--runs-root", work + "/pipeline-runs"], root)

namespace ∈ dict[str, object] ← globals()
module_name ∈ str ← namespace.get("__name__", "")
if module_name == "__main__":
    main()
