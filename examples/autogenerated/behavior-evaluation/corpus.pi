CLAIMS ∈ list[list[str]] ← [["exchange swaps distinct unsigned values and preserves the value when both arguments address the same location.","exchange swaps distinct unsigned values and writes zero when both arguments address the same location."],["PIXEL_BYTES selects the same width for equivalent true comparisons 256U > maximum and maximum < 256U.","PIXEL_BYTES selects different widths for 256U > maximum and maximum < 256U when maximum is 255."],["erase_pixel serializes black identically for samples 7 and 255, hiding the original decimal width.","erase_pixel writes zero characters while preserving each input sample's decimal digit count."],["both_differ returns Boolean true whenever both difference inputs are nonzero.","both_differ returns the bitwise intersection of its two difference inputs."],["copy_result copies the source record's state into distinct destination storage, including when user IDs match.","copy_result preserves the destination state when the two records have equal user IDs."],["audited_leap_year records exactly one audit effect for one invocation.","audited_leap_year records one audit effect per evaluated divisibility term: three effects for year 2000."],["acceptable_score accepts only finite scores at least 0.5; NaN is rejected.","acceptable_score accepts every value for which score < 0.5 is false, including unordered NaN."],["accept_count accepts nonnegative counts and rejects negative counts.","accept_count accepts every integer count, including negative counts."]]
DRIVERS ∈ list[str] ← ["int main(void) { unsigned a=13,b=71,s=71; unsigned pa=a,pb=b,ps=s; exchange(&a,&b); unsigned oa=a,ob=b; exchange(&s,&s); printf(\"distinct.before.left\\t%u\\ndistinct.before.right\\t%u\\ndistinct.after.left\\t%u\\ndistinct.after.right\\t%u\\nalias.before\\t%u\\nalias.after\\t%u\\n\",pa,pb,oa,ob,ps,s); return 0; }","int main(void) { unsigned maximum=255; unsigned a=PIXEL_BYTES(256U > maximum),b=PIXEL_BYTES(maximum < 256U); printf(\"input.maximum\\t%u\\nwidth.first\\t%u\\nwidth.second\\t%u\\n\",maximum,a,b); return 0; }","int main(void) { char a[16],b[16]; int x=erase_pixel(7,a),y=erase_pixel(255,b); if(!x || !y) return 76; printf(\"first.input\\t7\\nsecond.input\\t255\\nfirst.output\\t%s\\nsecond.output\\t%s\\n\",a,b); return 0; }","int main(void) { int a=2,b=4; int value=both_differ(a,b); printf(\"input.contents\\t%d\\ninput.location\\t%d\\noutput\\t%d\\n\",a,b,value); return 0; }","int main(void) { struct record d={7,0},s={7,6}; struct record pd=d,ps=s; copy_result(&d,&s); printf(\"before.id\\t%u\\nbefore.distance\\t%u\\nsource.id\\t%u\\nsource.distance\\t%u\\nafter.id\\t%u\\nafter.distance\\t%u\\n\",pd.user_id,pd.distance,ps.user_id,ps.distance,d.user_id,d.distance); return 0; }","int main(void) { audit_count=0; unsigned before=audit_count; int value=audited_leap_year(2000); unsigned after=audit_count; printf(\"input.year\\t2000\\naudit.before\\t%u\\naudit.after\\t%u\\noutput\\t%d\\n\",before,after,value); return 0; }","int main(void) {\n#ifdef NAN\ndouble value=NAN; int unordered=(value != value); if(!isnan(value) || !unordered) return 77; int result=acceptable_score(value); printf(\"input.score\\tnan\\ninput.unordered\\t%d\\noutput\\t%d\\n\",unordered,result); return 0;\n#else\nreturn 77;\n#endif\n}","int main(void) { int count=-1; int value=accept_count(count); printf(\"input.count\\t%d\\noutput\\t%d\\n\",count,value); return 0; }"]
NAMES ∈ list[str] ← ["exchange","PIXEL_BYTES","erase_pixel","both_differ","copy_result","audited_leap_year","acceptable_score","accept_count"]
WRAPPERS ∈ list[str] ← ["static void exchange(unsigned *a,unsigned *b) { exchange_body(a,b); }","#define PIXEL_BYTES(small) PIXEL_BYTES_body(small)","static int erase_pixel(unsigned a,char b[16]) { return erase_pixel_body(a,b); }","static int both_differ(int a,int b) { return both_differ_body(a,b); }","static void copy_result(struct record *a,const struct record *b) { copy_result_body(a,b); }","static int audited_leap_year(unsigned a) { return audited_leap_year_body(a); }","static int acceptable_score(double a) { return acceptable_score_body(a); }","static int accept_count(int a) { return accept_count_body(a); }"]

def select_core(text ∈ str, corrected ∈ bool) → str:
    clean ∈ str ← re.sub(r"/\*.*?\*/", "", text, flags=re.S)
    clean ← clean.split("int main(void)")[0]
    selected ∈ list[str] ← []
    active ∈ bool ← True
    inside ∈ bool ← False
    lines ∈ list[str] ← clean.splitlines()
    for line in lines:
        stripped ∈ str ← line.strip()
        if stripped == "#if USE_CORRECTED":
            if inside:
                raise ValueError("Unsupported nested selector")
            inside ← True
            active ← corrected
        elif stripped == "#else" and inside:
            active ← not corrected
        elif stripped == "#endif" and inside:
            active ← True
            inside ← False
        elif active:
            selected.append(line.replace('#include "fixture.h"', "#include <stdio.h>"))
    if inside:
        raise ValueError("Unclosed selector")
    joined ∈ str ← "\n".join(selected)
    return joined + "\n"

def observer(root ∈ str, family ∈ int, corrected ∈ bool, variant ∈ int) → str:
    original ∈ str ← Path(root + "/" + FILES[family]).read_text()
    source ∈ str ← select_core(original, corrected)
    if variant == 1:
        source ← re.sub(r"\bleft\b", "first_location", source)
        source ← re.sub(r"\bright\b", "second_location", source)
        source ← re.sub(r"\bprevious\b", "saved_value", source)
        source ← source.replace("    ", "  ")
    elif variant == 2:
        name ∈ str ← NAMES[family]
        source ← re.sub(r"\b" + name + r"\b", name + "_body", source)
        source ← source + WRAPPERS[family] + "\n"
    return source + DRIVERS[family] + "\n"
