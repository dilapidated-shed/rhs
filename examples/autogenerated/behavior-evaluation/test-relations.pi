"""Specified positive twins, witnessed counterexamples, and domain boundaries."""
import sys
import subprocess
import time
from pathlib import Path
from builtins import ValueError
import checker
import finding as finding_values

CLAIMS ∈ dict[str, str] ← {"counts/bytes-elements": "The reported byte count equals element count times bytes per element.", "calls/count-order-effects": "The recorded calls follow the required order, with the declared count and effect delta.", "dimensions/scalar-vector": "The array explicitly encodes one real vector whose dimension equals the number of stored scalar coordinates.", "dimensions/row-vectors": "Each row of this rank-two array explicitly encodes a real vector with the declared dimension.", "transform/reflection": "For the recorded input and nonzero normal, the output is the Euclidean hyperplane reflection.", "transform/rotation": "The declared rational matrix is a proper Euclidean rotation and produces the recorded output.", "transform/linear": "The declared rational matrix applied to the recorded input produces the recorded output.", "repeat/idempotent": "After the first call, the second call preserves both the recorded state and serialized output.", "repeat/pure": "Both recorded calls preserve the input state and produce identical serialized output.", "serialization/state-canonical-int": "Two recorded calls advance integer state by the declared increment and serialize each state as canonical decimal UTF-8."}

def observation(fields ∈ dict[str, str]) → str:
    lines ∈ list[str] ← []
    for key in fields:
        lines.append(key + "\t" + fields[key])
    return str("\n".join(lines)) + "\n"

def require(relation ∈ str, fields ∈ dict[str, str], expected ∈ str) → None:
    text ∈ str ← observation(fields)
    source ∈ str ← checker.digest(b"declared static observation fixture; not native execution")
    claim ∈ str ← checker.digest(relation.encode())
    result ∈ dict[str, str] ← checker.finding(relation, text, "completed", source, claim)
    if result["status"] != expected:
        raise ValueError("Wrong exact relation verdict: " + relation + " expected " + expected + " got " + result["status"])
    if expected == "contradiction" and result["witness"] != text:
        raise ValueError("Contradiction lost its supplied observation witness")

def twins(relation ∈ str, good ∈ dict[str, str], key ∈ str, bad_value ∈ str) → None:
    require(relation, good, "agreement-tested")
    bad ∈ dict[str, str] ← good.copy()
    bad[key] ← bad_value
    require(relation, bad, "contradiction")
    incomplete ∈ dict[str, str] ← {}
    require(relation, incomplete, "unknown")

def selftest() → None:
    twins("counts/bytes-elements", {"element_count": "3", "element_width_bytes": "4", "reported_bytes": "12"}, "reported_bytes", "3")
    require("counts/bytes-elements", {"element_count": "0", "element_width_bytes": "8", "reported_bytes": "0"}, "agreement-tested")
    require("counts/bytes-elements", {"element_count": "1", "element_width_bytes": "0", "reported_bytes": "0"}, "unknown")
    require("counts/bytes-elements", {"element_count": "-1", "element_width_bytes": "4", "reported_bytes": "4"}, "unknown")
    calls ∈ dict[str, str] ← {"required_order": "load,write", "observed_order": "load,write", "call_count": "2", "effects_per_call": "1", "effects.before": "10", "effects.after": "12"}
    twins("calls/count-order-effects", calls, "observed_order", "write,load")
    twins("calls/count-order-effects", calls, "call_count", "1")
    twins("calls/count-order-effects", calls, "effects.after", "13")
    require("calls/count-order-effects", {"required_order": "", "observed_order": "", "call_count": "0", "effects_per_call": "0", "effects.before": "2", "effects.after": "2"}, "agreement-tested")
    dimensions ∈ dict[str, str] ← {"scalar_field": "real", "array.shape": "2,3", "array.rank": "2", "vector.dimension": "6", "coordinates.count": "6"}
    twins("dimensions/scalar-vector", dimensions, "vector.dimension", "2")
    dimensions["vector.dimension"] ← "3"
    twins("dimensions/row-vectors", dimensions, "vector.dimension", "6")
    dimensions["scalar_field"] ← "unknown"
    require("dimensions/row-vectors", dimensions, "unknown")
    require("dimensions/scalar-vector", {"scalar_field": "real", "array.shape": "0,3", "array.rank": "2", "vector.dimension": "0", "coordinates.count": "0"}, "agreement-tested")
    require("dimensions/scalar-vector", {"scalar_field": "real", "array.shape": "", "array.rank": "0", "vector.dimension": "1", "coordinates.count": "1"}, "agreement-tested")
    twins("transform/reflection", {"input": "3,4", "normal": "1,1", "output.numerators": "-8,-6", "output.denominator": "2"}, "output.numerators", "8,6")
    require("transform/reflection", {"input": "3,4", "normal": "0,0", "output.numerators": "3,4", "output.denominator": "1"}, "unknown")
    require("transform/reflection", {"input": "5", "normal": "3", "output.numerators": "-5", "output.denominator": "1"}, "agreement-tested")
    rotation ∈ dict[str, str] ← {"input": "5,0", "matrix.numerators": "3,-4;4,3", "matrix.denominator": "5", "output.numerators": "3,4", "output.denominator": "1"}
    twins("transform/rotation", rotation, "output.numerators", "3,-4")
    require("transform/rotation", {"input": "3,4", "matrix.numerators": "-1,0;0,1", "matrix.denominator": "1", "output.numerators": "-3,4", "output.denominator": "1"}, "contradiction")
    require("transform/rotation", {"input": "0,0", "matrix.numerators": "2,0;0,2", "matrix.denominator": "1", "output.numerators": "0,0", "output.denominator": "1"}, "contradiction")
    require("transform/rotation", {"input": "5", "matrix.numerators": "1", "matrix.denominator": "1", "output.numerators": "5", "output.denominator": "1"}, "agreement-tested")
    twins("transform/linear", {"input": "3,4", "matrix.numerators": "2,1;-1,3", "matrix.denominator": "1", "output.numerators": "10,9", "output.denominator": "1"}, "output.numerators", "11,9")
    require("transform/linear", {"input": "3,4", "matrix.numerators": "1,1", "matrix.denominator": "1", "output.numerators": "7", "output.denominator": "1"}, "agreement-tested")
    require("transform/linear", {"input": "3,4", "matrix.numerators": "0,0;0,0", "matrix.denominator": "1", "output.numerators": "0,0", "output.denominator": "1"}, "agreement-tested")
    require("transform/linear", {"input": "3,4", "matrix.numerators": "1;2", "matrix.denominator": "1", "output.numerators": "3,6", "output.denominator": "1"}, "unknown")
    repeated ∈ dict[str, str] ← {"call_count": "2", "state.before": "0", "state.after.1": "7", "state.after.2": "7", "serialized.1": "37", "serialized.2": "37"}
    twins("repeat/idempotent", repeated, "state.after.2", "8")
    repeated["state.before"] ← "7"
    twins("repeat/pure", repeated, "state.before", "0")
    repeated["call_count"] ← "1"
    require("repeat/pure", repeated, "unknown")
    serialized ∈ dict[str, str] ← {"call_count": "2", "encoding": "decimal-utf8-hex", "state.before": "4", "increment": "2", "state.after.1": "6", "state.after.2": "8", "serialized.1": "36", "serialized.2": "38"}
    twins("serialization/state-canonical-int", serialized, "serialized.1", "37")
    serialized["encoding"] ← "arbitrary-json"
    require("serialization/state-canonical-int", serialized, "unknown")
    unsupported ∈ dict[str, str] ← {"output": "1"}
    require("claim/infer-from-variable-name", unsupported, "unknown")
    print("PASS exact relation controls, counterexamples and explicit domain boundaries")

def native(binary ∈ str, output ∈ str, root ∈ str) → None:
    Path(output).mkdir(parents=True, exist_ok=False)
    groups ∈ list[list[str]] ← [["counts", "counts/bytes-elements"], ["calls", "calls/count-order-effects"], ["scalar", "dimensions/scalar-vector"], ["rows", "dimensions/row-vectors"], ["reflection", "transform/reflection"], ["rotation", "transform/rotation"], ["linear", "transform/linear"], ["idempotent", "repeat/idempotent"], ["pure", "repeat/pure"], ["serialization", "serialization/state-canonical-int"]]
    receipts ∈ list[str] ← ["case\trelation\tstatus\tobservation_sha256\tbinary_sha256"]
    binary_hash ∈ str ← checker.digest(Path(binary).read_bytes())
    source_path ∈ str ← "examples/autogenerated/behavior-evaluation/relation-observer.c"
    source_hash ∈ str ← checker.digest(Path(root + "/" + source_path).read_bytes())
    identity ∈ object ← subprocess.run(["git", "rev-parse", "HEAD"], cwd=root, capture_output=True, text=True, check=True)
    revision ∈ str ← identity.stdout.strip()
    for group in groups:
        for mutant in [0, 1]:
            identifier ∈ str ← group[0] + "-" + str(mutant)
            command ∈ list[str] ← [binary, group[0], str(mutant)]
            result ∈ object ← subprocess.run(command, capture_output=True, timeout=10)
            directory ∈ str ← output + "/" + identifier
            Path(directory).mkdir()
            Path(directory + "/stdout.bin").write_bytes(result.stdout)
            Path(directory + "/stderr.bin").write_bytes(result.stderr)
            code ∈ int ← result.returncode
            Path(directory + "/exit.txt").write_text(str(code) + "\n")
            if code != 0:
                raise ValueError("Native relation observer failed")
            text ∈ str ← result.stdout.decode()
            claim ∈ str ← CLAIMS[group[1]]
            claim_hash ∈ str ← checker.digest(claim.encode())
            Path(directory + "/claim.txt").write_text(claim)
            finding ∈ dict[str, str] ← checker.finding(group[1], text, "completed", source_hash, claim_hash)
            expected ∈ str ← "agreement-tested"
            if mutant == 1:
                expected ← "contradiction"
            if finding["status"] != expected or (mutant == 1 and finding["witness"] != text):
                raise ValueError("Native positive twin or witnessed counterexample failed")
            Path(directory + "/finding.txt").write_text(checker.ragged(finding))
            argv ∈ str ← str("\n".join(command)) + "\n"
            Path(directory + "/argv.txt").write_text(argv)
            stdout_hash ∈ str ← checker.digest(result.stdout)
            stderr_hash ∈ str ← checker.digest(result.stderr)
            execution ∈ str ← "state\tcompleted\nexit\t0\nargv.sha256\t" + str(checker.digest(argv.encode())) + "\nbinary.sha256\t" + binary_hash + "\nstdout.sha256\t" + stdout_hash + "\nstderr.sha256\t" + stderr_hash + "\n"
            Path(directory + "/execution.tsv").write_text(execution)
            source_value ∈ finding_values.SourceIdentity ← finding_values.SourceIdentity("dilapidated-shed/rhs", revision, source_path, source_hash)
            claim_value ∈ finding_values.ClaimIdentity ← finding_values.ClaimIdentity(group[1], claim_hash)
            behavior_value ∈ finding_values.ObservedBehavior ← finding_values.ObservedBehavior("utf8-tsv", stdout_hash)
            scope_value ∈ finding_values.ExecutionScope ← finding_values.ExecutionScope("Ubuntu/x86_64", "native-process", identifier, "supplied-native-observation")
            hashes_value ∈ finding_values.EvidenceHashes ← finding_values.EvidenceHashes(binary_hash, stdout_hash, stderr_hash, str(checker.digest(execution.encode())))
            created ∈ int ← int(time.time())
            exact_value ∈ finding_values.ExactFinding ← finding_values.ExactFinding(source_value, claim_value, behavior_value, scope_value, hashes_value, group[1], finding["status"], created, created + 86400)
            fields_value ∈ dict[str, str] ← finding_values.exact_fields(exact_value)
            Path(directory + "/finding.tsv").write_text(finding_values.serialize(fields_value))
            receipts.append(identifier + "\t" + group[1] + "\t" + expected + "\t" + finding["observation"] + "\t" + binary_hash)
    Path(output + "/cases.tsv").write_text(str("\n".join(receipts)) + "\n")
    print("PASS 20 native observed relation cases; supplied execution scope only")

arguments ∈ list[str] ← sys.argv
if arguments[1] == "selftest":
    selftest()
else:
    selftest()
    native(arguments[1], arguments[2], arguments[3])
