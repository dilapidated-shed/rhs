"""GitHub custom command executor; run text is an absolute work path, not shell."""
import sys
import os
import json
import subprocess
from pathlib import Path
from builtins import ValueError, globals
import checker

def run(argv ∈ list[str], cwd ∈ str) → None:
    result ∈ object ← subprocess.run(argv, cwd=cwd)
    code ∈ int ← result.returncode
    if code != 0:
        raise ValueError("Required stage failed with exit " + str(code))

def seal(work ∈ str) → None:
    material ∈ list[str] ← ["repository\tcommit\tpath\tsha256"]
    for repository in ["rhs", "flexible-pipes", "catfood", "ithon", "ick"]:
        result ∈ object ← subprocess.run(["git", "rev-parse", "HEAD"], cwd=work + "/" + repository, check=True, capture_output=True, text=True)
        revision ∈ str ← result.stdout.strip()
        tracked ∈ object ← subprocess.run(["git", "ls-files", "-z"], cwd=work + "/" + repository, check=True, capture_output=True, text=True)
        paths ∈ list[str] ← tracked.stdout.split("\0")
        for path in paths:
            absolute ∈ str ← work + "/" + repository + "/" + path
            if path != "" and Path(absolute).is_file():
                # The complete ICK tree stays pinned by commit/submodule identities;
                # hash its small owned build overlay, not the foreign GCC substrate.
                if repository != "ick" or path.startswith("ick/") or path.startswith(".github/"):
                    content_hash ∈ str ← checker.digest(Path(absolute).read_bytes())
                    material.append(repository + "\t" + revision + "\t" + path + "\t" + content_hash)
        if repository == "ick":
            modules ∈ object ← subprocess.run(["git", "submodule", "status", "--recursive"], cwd=work + "/" + repository, check=True, capture_output=True, text=True)
            Path(work + "/evidence/ick-submodules.txt").write_text(modules.stdout)
    joined ∈ str ← "\n".join(material)
    Path(work + "/evidence/materials.tsv").write_text(joined + "\n")

def main() → None:
    arguments ∈ list[str] ← sys.argv
    args ∈ list[str] ← arguments[1:]
    mode ∈ str ← args[0]
    work ∈ str ← Path(args[1]).read_text().strip()
    if work != "/home/runner/work/rhs/rhs/work" or not Path(work + "/rhs").is_dir():
        raise ValueError("GitHub executor requires an explicit absolute work directory")
    ithon ∈ str ← work + "/ithon/ithon"
    experiment ∈ str ← work + "/rhs/examples/autogenerated/behavior-evaluation"
    if mode == "frontend":
        failed ∈ bool ← False
        for source in [experiment + "/evaluate.pi", experiment + "/verify.pi", work + "/flexible-pipes/scripts/rhs-model.pi", work + "/catfood/profiles/rhs-evaluation/provision.pi"]:
            result ∈ object ← subprocess.run([ithon, source, "check"], cwd=work)
            code ∈ int ← result.returncode
            if code != 0:
                failed ← True
        if failed:
            raise ValueError("One or more maintained Ithon frontend checks failed")
    elif mode == "execute":
        Path(work + "/evidence").mkdir(parents=True, exist_ok=True)
        seal(work)
        run([ithon, work + "/catfood/profiles/rhs-evaluation/provision.pi", work], work)
        environment ∈ dict[str, str] ← os.environ
        environment["ITHON_PYTHON"] ← work + "/model-runtime/bin/python"
        environment["RHS_SOURCE_ROOT"] ← work + "/rhs"
        environment["RHS_EVIDENCE_ROOT"] ← work + "/evidence"
        environment["RHS_PROFILE_ROOT"] ← work + "/profile"
        environment["ITHON_ENTRYPOINT"] ← ithon
        environment["FLEXIBLE_PIPES_ROOT"] ← work + "/flexible-pipes"
        old_path ∈ str ← os.environ.get("PATH", "")
        environment["PATH"] ← work + "/profile/bin:" + old_path
        # Existing Python runner is explicit migration debt; new orchestration is Grease.
        run([work + "/model-runtime/bin/python", work + "/flexible-pipes/scripts/run-pipeline", "rhs-behavior-evaluation", "--runs-root", work + "/pipeline-runs"], work + "/flexible-pipes")
    else:
        raise ValueError("Unsupported CI stage")

namespace ∈ dict[str, object] ← globals()
module_name ∈ str ← namespace.get("__name__", "")
if module_name == "__main__":
    main()
