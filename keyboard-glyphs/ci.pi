"""Hosted FP → Kitchen → AI-CI glyph acceptance; Cat Food owns acquisition."""
import sys
import os
import subprocess
from pathlib import Path
from builtins import ValueError, globals

def run(argv ∈ list[str], root ∈ str) → None:
    result ∈ object ← subprocess.run(argv, cwd=root)
    code ∈ int ← result.returncode
    if code != 0:
        raise ValueError("Required RHS glyph acceptance stage failed")

def main() → None:
    arguments ∈ list[str] ← sys.argv
    root ∈ str ← Path(arguments[1]).read_text().strip()
    if root != "/home/runner/work/rhs/rhs":
        raise ValueError("Glyph executor requires the positively identified GitHub workspace")
    work ∈ str ← root + "/.glyph-work"
    ithon ∈ str ← work + "/ithon/ithon"
    pins ∈ dict[str, str] ← {"ithon": "d6e83969f82512e920fb17b44326cb54f31d015c", "catfood": "90471095201bcabeb7ef920fa0101f4e667d1454", "ai-ci": "a9aa38707c15f2909a40f226621dadf04010d7d9", "kitchen": "3280a9f370d91298f959ffe0d367773ad74c799b", "flexible-pipes": "d88e90371f51254fb68a5d9128e5238c0b448de0"}
    for owner in pins:
        result ∈ object ← subprocess.run(["git", "rev-parse", "HEAD"], cwd=work + "/" + owner, capture_output=True, text=True, check=True)
        observed ∈ str ← result.stdout.strip()
        if observed != pins[owner]:
            raise ValueError("RHS glyph owner revision mismatch: " + owner)
    run([ithon, work + "/catfood/profiles/rhs-evaluation/provision.pi", "grease", work], root)
    environment ∈ dict[str, str] ← os.environ
    old_path ∈ str ← environment.get("PATH", "")
    environment["PATH"] ← work + "/profile/bin:" + old_path
    run(["python3", work + "/flexible-pipes/scripts/run-pipeline", "rhs-glyph-acceptance", "--param", "kitchen_task=" + work + "/kitchen/tasks/rhs-autonomous/2.grease", "--param", "rhs=" + root, "--param", "evidence=" + work + "/evidence", "--param", "ithon=" + ithon, "--param", "checker=" + work + "/ai-ci/validators/rhs_glyph.pi", "--runs-root", work + "/pipeline-runs"], root)

namespace ∈ dict[str, object] ← globals()
module_name ∈ str ← namespace.get("__name__", "")
if module_name == "__main__":
    main()
